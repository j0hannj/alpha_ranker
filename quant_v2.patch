+import pandas as pd
+from sklearn.cluster import KMeans
+
+def detect_regimes(returns, n_regimes=3):
+
+    vol = returns.rolling(60).std()
+
+    X = pd.concat([
+        returns.mean(axis=1),
+        vol.mean(axis=1)
+    ], axis=1).dropna()
+
+    model = KMeans(n_clusters=n_regimes)
+    regimes = model.fit_predict(X)
+
+    regime_series = pd.Series(regimes, index=X.index)
+
+    return regime_series


