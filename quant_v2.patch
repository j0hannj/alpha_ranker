+++ b/src/quant/factors.py
@@
+import pandas as pd
+
+def factor_momentum(prices):
+
+    px = prices.unstack()
+
+    return px.pct_change(252).stack().rename("momentum")
+
+
+def factor_reversal(prices):
+
+    px = prices.unstack()
+
+    return -px.pct_change(21).stack().rename("reversal")
+
+
+def factor_volatility(prices):
+
+    ret = prices.unstack().pct_change()
+
+    return ret.rolling(63).std().stack().rename("volatility")


